% Tectonic-compatible patch for fontawesome5-utex-helper.sty
%
% Root cause: the upstream XeTeX path iterates over all font glyphs using
% \XeTeXglyphname (lines 50-62 of the original).  \XeTeXglyphname hangs
% indefinitely in tectonic 0.16.9 (SIGABRT / infinite wait), even though
% \XeTeXglyphindex and \XeTeXcountglyphs work fine.
%
% Fix: skip the glyph-name iteration entirely.  Instead:
%  - \__fontawesome_analyze_font:nn just loads the font (no glyph scan).
%  - \__fontawesome_glyphindex:n uses \XeTeXglyphindex (works in tectonic).
%  - \__fontawesome_glyph:w uses \XeTeXglyph (works in tectonic).
%  - Pre-define every \fa* macro that moderncv banking style needs, exactly as
%    the original iteration would have defined them.
%
% Icons not pre-defined here simply won't resolve (glyph index 0 → no output),
% but moderncv uses only the macros listed below.

\@ifpackageloaded{fontawesome5}{}{\PackageError{fontawesome5-utex-helper}{Load fontawesome5, not this file directly.}{}}
\@ifpackagelater{expl3}{2017/05/26}{}{
  \PackageError{fontawesome5}{expl3 too old}{}
  \endinput
}

\ProvidesExplPackage{fontawesome5-utex-helper}{2021/06/04}{5.15.3}{uTeX helper for fontawesome5 (tectonic-compat patch)}

\sys_if_engine_luatex:TF{
  % LuaTeX path — unchanged from upstream (not affected by the tectonic bug).
  \RequirePackage{luatexbase}
  \directlua{require('fontawesome5')}
  \cs_new:Nn\__fontawesome_analyze_font:nn{
    \group_begin:
      \usefont{TU}{fontawesome#1}{#2}{n}
      \lua_now:e{fontawesome5_analyze_current_font(\tex_fontid:D\tex_font:D)}
    \group_end:
  }
  \cs_set:Npn \__fontawesome_glyphindex:n {
    \lua_now:e{tex.sprint(font.getfont(font.current()).resources.unicodes[token.scan_string()]~or~0)}
  }
  \cs_set_eq:NN\__fontawesome_glyph:w\tex_char:D
}{
  % XeTeX path — patched to skip \XeTeXglyphname iteration.
  \cs_new:Nn\__fontawesome_analyze_font:nn{
    \group_begin:
      \usefont{TU}{fontawesome#1}{#2}{n}%  load the font; skip glyph scan
    \group_end:
  }
  \cs_set:Nn\__fontawesome_glyphindex:n{
    \the\tex_XeTeXglyphindex:D"#1"\scan_stop:
  }
  \cs_set_eq:NN\__fontawesome_glyph:w\tex_XeTeXglyph:D
}

% Load fonts (no glyph iteration).
\__fontawesome_analyze_font:nn{\c__fontawesome_kind_tl}{solid}
\__fontawesome_analyze_font:nn{brands}{regular}

% Pre-define \fa* macros needed by moderncv banking style.
% Pattern matches what the original glyph iteration would have produced:
%   \cs_gset:Npx\faSomeName{\faPreselectedIcon{some-name}}
% The \faPreselectedIcon{X} s O{} interface means:
%   \faSomeName      → solid "some-name" icon
%   \faSomeName*     → solid "some-name-alt" icon  (s arg → appends -alt)
%   \faSomeName[reg] → "some-name" icon in "reg" style

