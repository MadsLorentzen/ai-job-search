{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills",
      ".agents/skills"
    ]
  },
  "agent": {
    "reviewer": {
      "description": "Reviews application drafts (CV and cover letter) for quality, ATS optimization, accuracy and consistency.",
      "mode": "subagent",
      "prompt": "You are a strict reviewer for job application materials. You receive CV and cover letter drafts inline and must provide structured feedback. Research the company when possible. Verify claims. Return JSON with edits, narrative suggestions, company research, ATS keyword gaps and verification notes. Never modify files directly."
    },
    "job-scorer": {
      "description": "Scores a job posting against the candidate profile.",
      "mode": "subagent",
      "prompt": "You are a job scoring agent. Read the candidate profile and evaluate the job posting. Return structured JSON containing technical_score, experience_score, behavioral_score, career_score, location_pass, dealbreaker_flags and overall_verdict."
    }
  },
  "command": {
    "apply": {
      "description": "Full drafter-reviewer workflow",
      "template": ".opencode/commands/apply.md"
    },
    "setup": {
      "description": "Profile onboarding",
      "template": ".opencode/commands/setup.md"
    },
    "scrape": {
      "description": "Search job portals",
      "template": ".opencode/commands/scrape.md"
    },
    "rank": {
      "description": "Rank scraped jobs",
      "template": ".opencode/commands/rank.md"
    },
    "interview": {
      "description": "Interview preparation",
      "template": ".opencode/commands/interview.md"
    },
    "outcome": {
      "description": "Record application results",
      "template": ".opencode/commands/outcome.md"
    },
    "expand": {
      "description": "Expand candidate profile",
      "template": ".opencode/commands/expand.md"
    },
    "upskill": {
      "description": "Generate learning plan",
      "template": ".opencode/commands/upskill.md"
    },
    "add-template": {
      "description": "Register LaTeX templates",
      "template": ".opencode/commands/add-template.md"
    },
    "add-portal": {
      "description": "Create a job portal skill",
      "template": ".opencode/commands/add-portal.md"
    },
    "reset": {
      "description": "Reset candidate profile",
      "template": ".opencode/commands/reset.md"
    }
  },
  "permission": {
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "task": "allow",
    "todowrite": "allow",
    "bash": {
      "bun run *": "allow",
      "python salary_lookup.py *": "allow",
      "python3 salary_lookup.py *": "allow",
      "pdftotext *": "allow",
      "lualatex *": "allow",
      "xelatex *": "allow",
      "*": "ask"
    }
  }
}