# Copy this file to `.env` (in the repo root) and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored and will never be committed. This `.env.example` is the
# committed template — keep real secrets out of it.
#
# Bun auto-loads `.env` from the directory you run `bun` in. The portal skills
# are invoked from the repo root (`bun run .agents/skills/<skill>/cli/src/cli.ts`),
# so a `.env` HERE — at the repo root — is what gets picked up. A `.env` inside
# a cli/ subfolder will NOT be loaded when the skill runs.

# --- usajobs-search -----------------------------------------------------------
# The only portal in this fork that authenticates. Register free (~2 min) at
# https://developer.usajobs.gov/apirequest/ — you get the key by email.
#
# USAJOBS_EMAIL must be the SAME address you registered with: it is sent as the
# User-Agent header, which is how USAJOBS identifies callers. A mismatch here
# returns HTTP 401 exactly like a wrong key does.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# After filling these in, enable the skill:
#   .agents/skills/usajobs-search/SKILL.md  →  enabled: false  →  enabled: true
