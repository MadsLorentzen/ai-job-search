# Server Configuration
PORT=3000

# Web App Password Authentication
# REQUIRED. The server refuses all logins until this is set to your own value.
# There is no built-in fallback password.
APP_PASSWORD=change-me-before-first-run
# AUTH_USERS=admin:password1,mate:password2

# Optional. Signs session tokens. Generated and stored in server/data/.session-secret
# when unset. Set it explicitly if you run more than one instance.
# SESSION_SECRET=

# ========================================================
# AI ENGINE CONFIGURATION (Claude / Kimi / Qwen / DeepSeek)
# ========================================================

# Option A: KIMI (Moonshot AI)
# KIMI_API_KEY=sk-your-moonshot-api-key-here
# KIMI_MODEL=moonshot-v1-32k
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Option B: QWEN (Alibaba DashScope / OpenRouter)
# QWEN_API_KEY=sk-your-dashscope-or-openrouter-key
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Option C: ANTHROPIC CLAUDE (API Key or CLI login)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Option D: Generic OpenAI-Compatible (DeepSeek, OpenRouter, Groq, Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
