# Server Configuration
PORT=3000

# Anthropic API Key (Required for AI features: Fit Evaluation, Resume & Cover Letter Drafting, Reviewer Agent, Interview Prep)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Default Model (default: claude-3-7-sonnet-20250219)
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
