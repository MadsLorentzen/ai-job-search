# Server Configuration
PORT=3000

# Web App Password Authentication
# REQUIRED. The server refuses all logins until one of these is set. There is
# no built-in fallback password.
#
# Preferred: run `npm run set-password` in server/, which writes a scrypt hash
# here. A leaked .env then costs a rotation rather than handing over the login.
# APP_PASSWORD_HASH=
#
# Legacy plaintext form. Still honoured so existing installs keep working, but
# the server warns at startup and points at `npm run set-password`.
APP_PASSWORD=change-me-before-first-run

# NOTE: this app is single-user. There is one profile and one application
# store, so a multi-user config (the former AUTH_USERS setting) could not be
# honoured by the data model and has been removed.

# Optional. Signs session tokens. Generated and stored in server/data/.session-secret
# when unset. Set it explicitly if you run more than one instance.
# SESSION_SECRET=

# Optional. Log verbosity: trace, debug, info (default), warn, error, silent.
# LOG_LEVEL=info

# Optional. Overrides the SQLite database location.
# DATABASE_FILE=

# Set AI_PROVIDER=none to disable every AI provider. Evaluation and drafting
# then report themselves unavailable instead of silently producing filler.
# AI_PROVIDER=

# ========================================================
# AI ENGINE CONFIGURATION (Claude / Kimi / Qwen / DeepSeek)
# ========================================================

# Option A: KIMI (Moonshot AI)
# KIMI_API_KEY=sk-your-moonshot-api-key-here
# KIMI_MODEL=moonshot-v1-32k
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Option B: QWEN (Alibaba DashScope / OpenRouter)
# QWEN_API_KEY=sk-your-dashscope-or-openrouter-key
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Option C: ANTHROPIC CLAUDE (API Key or CLI login)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Option D: Generic OpenAI-Compatible (DeepSeek, OpenRouter, Groq, Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
