# Server Configuration
PORT=3000

# Web App Password Authentication (protects your dashboard from unauthorized visitors)
# Set your master access password (or comma-separated users: AUTH_USERS=you:pass1,mate:pass2)
APP_PASSWORD=oppertuneX!@#$999
# AUTH_USERS=admin:password1,mate:password2

# Anthropic API Key (Optional if you log in via 'claude' CLI on your server)
ANTHROPIC_API_KEY=

# Default Model
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
